	$(CPP_NEON) $(OPENMP) -DUSE_OMP -DUSE_MBLAS $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_qd.cc -l$(MPBLAS_LIBNAME)_qd $(LIB_NEON_OMP) -o matmulbench_qd_mblas_omp_neon
