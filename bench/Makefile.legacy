#	-./matmulbench_mpf_winograd_static $(MPF_PREC) $(MIN_DIM) $(MAX_SECONDS)
#	-./matmulbench_mpf_winograd_rec $(MPF_PREC) $(ROW_DIM) $(MAX_SECONDS)

