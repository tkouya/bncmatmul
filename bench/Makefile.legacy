strassen_general_qd_omp_avx2: matmul_strassen.h matmul_strassen_general_qd_omp.c mpfr_dtq_sd.c  qdlinear.h qdlinear.c
	$(CC_AVX2) $(INC) -c qdlinear.c -o qdlinear_avx2.o
	$(CC_AVX2) $(OPENMP) $(INC) -c bncomp_linear.c -o bncomp_linear_avx2.o
	$(CC_AVX2) $(INC) -c matmul_strassen_general_qd.c -o matmul_strassen_general_qd_avx2.o
	$(CC_AVX2) $(OPENMP) -DDEBUG $(INC) matmul_strassen_general_qd_omp.c matmul_strassen_general_qd_avx2.o gtestmat_qd.o bncomp_linear_avx2.o qdlinear_avx2.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_qd_omp_avx2
	$(CC_AVX2) $(OPENMP) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_qd_omp.c matmul_strassen_general_qd_avx2.o gtestmat_qd.o bncomp_linear_avx2.o qdlinear_avx2.o get_sec.o $(COMMON_LIB) -o strassen_general_winograd_qd_omp_avx2

# --------------------------
# lu_bench
# --------------------------
#lu_bench: ../include/matmul_strassen.h lu_bench.c
lu_bench: ../include/matmul_strassen.h lu_bench.c
	$(CC) $(INC) -DUSE_BLOCK lu_bench.c $(LIB) -o lu_bench_block
	$(CC) $(INC) -DUSE_BLOCK -DUSE_SCALING lu_bench.c $(LIB) -o lu_bench_block_scale
	$(CC) $(INC) -DUSE_STRASSEN lu_bench.c $(LIB) -o lu_bench
	$(CC) $(INC) -DUSE_STRASSEN -DUSE_SCALING lu_bench.c $(LIB) -o lu_bench_scale
#	$(CC) $(INC) -DUSE_WINOGRAD lu_bench.c $(LIB) -o lu_bench_winograd
#	$(CC) $(INC) -DUSE_WINOGRAD -DUSE_SCALING lu_bench.c $(LIB) -o lu_bench_winograd_scale
	$(CC) $(INC) -DUSE_LOTKIN -DUSE_BLOCK lu_bench.c $(LIB) -o lu_bench_block_lotkin
	$(CC) $(INC) -DUSE_LOTKIN -DUSE_BLOCK -DUSE_SCALING lu_bench.c $(LIB) -o lu_bench_block_scale_lotkin
	$(CC) $(INC) -DUSE_LOTKIN -DUSE_STRASSEN lu_bench.c $(LIB) -o lu_bench_lotkin
	$(CC) $(INC) -DUSE_LOTKIN -DUSE_STRASSEN -DUSE_SCALING lu_bench.c $(LIB) -o lu_bench_scale_lotkin
	$(CC) $(INC) -DUSE_OZ -DOZ_MAX_NUM_DIV=8 lu_bench.c $(LIB) -o lu_bench_oz_mnd8
	$(CC) $(INC) -DUSE_OZ -DOZ_MAX_NUM_DIV=9 lu_bench.c $(LIB) -o lu_bench_oz_mnd9
	$(CC) $(INC) -DUSE_OZ -DOZ_MAX_NUM_DIV=10 lu_bench.c $(LIB) -o lu_bench_oz_mnd10
