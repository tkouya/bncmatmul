	$(CPP_NEON) -DUSE_MBLAS $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_qd.cc -L$(MPLAPACK_LIB_PATH) -l$(MPBLAS_LIBNAME)_qd $(LIB_NEON) -o matmulbench_qd_mblas_neon
	$(CPP_NEON) -DUSE_BLOCK $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_qd.cc $(LIB_NEON) -o matmulbench_qd_block_neon
	$(CPP_NEON) -DUSE_STRASSEN $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_qd.cc $(LIB_NEON) -o matmulbench_qd_strassen_neon
