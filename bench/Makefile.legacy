matvecbench_dd: matvecbench_dd.cc
	$(CPP) $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matvecbench_dd.cc $(LIB) -o matvecbench_dd
	$(CPP) -DUSE_MBLAS $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matvecbench_dd.cc -L$(MPLAPACK_LIB_PATH) -l$(MPBLAS_LIBNAME)_dd $(LIB) -o matvecbench_dd_mblas
	$(CPP) $(OPENMP) -DUSE_OMP $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matvecbench_dd.cc $(LIB_OMP) -o matvecbench_dd_omp
	$(CPP) $(OPENMP) -DUSE_OMP -DUSE_MBLAS $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matvecbench_dd.cc -L$(MPLAPACK_LIB_PATH) -l$(MPBLAS_LIBNAME)_dd $(LIB_OMP) -o matvecbench_dd_mblas_omp

matvecbench_cdd: matvecbench_cdd.cc
	$(CPP) $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matvecbench_cdd.cc $(LIB) -o matvecbench_cdd
	$(CPP) -DUSE_MBLAS $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matvecbench_cdd.cc -L$(MPLAPACK_LIB_PATH) -l$(MPBLAS_LIBNAME)_dd $(LIB) -o matvecbench_cdd_mblas
	$(CPP) $(OPENMP) -DUSE_OMP $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matvecbench_cdd.cc $(LIB_OMP) -o matvecbench_cdd_omp
	$(CPP) $(OPENMP) -DUSE_OMP -DUSE_MBLAS $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matvecbench_cdd.cc -L$(MPLAPACK_LIB_PATH) -l$(MPBLAS_LIBNAME)_dd $(LIB_OMP) -o matvecbench_cdd_mblas_omp


cond_mat: cond_mat.c $(BNCMATMUL_LIBNAME)
	$(CC) $(INC) cond_mat.c $(LIB) -o cond_mat

#c_dd_qd: c_dd.c c_qd.c c_dd_qd.h
c_dd_qd: c_dd_qd.h
#	$(CC) $(INC) -c fpu.c -o fpu.o
#	$(CC) $(INC) -c c_dd.c -o c_dd.o
#	$(CC) $(INC) -c c_qd.c -o c_qd.o
#	$(AR) libc_dd_qd.a fpu.o
#	$(AR) libc_dd_qd.a c_dd.o
#	$(AR) libc_dd_qd.a c_qd.o
	$(CC) $(INC) -c ddlinear.c -o ddlinear_c.o
	$(CC) $(INC) -DDEBUG ddlinear.c $(COMMON_LIB) rdd.o -o ddlinear_test_c

test_iterative_ref: test_iterative_ref.c ../include/matmul_strassen.h
	$(CC) -DUSE_GMP -DUSE_MPFR $(INC) test_iterative_ref.c get_linear_system.c $(LIB) -o test_iterative_ref
	$(CC) -DUSE_GMP -DUSE_MPFR $(OPENMP) $(INC) test_iterative_ref.c get_linear_system.c mpflu.c $(LIB_OMP) -o test_iterative_ref_omp

test_iterative_ref_avx2: test_iterative_ref.c ../include/matmul_strassen.h
	$(CC_AVX2) -DUSE_GMP -DUSE_MPFR $(INC) test_iterative_ref.c get_linear_system.c mpflu.c $(LIB_AVX2) -o test_iterative_ref_avx2
	$(CC_AVX2) -DUSE_GMP -DUSE_MPFR $(OPENMP) $(INC) test_iterative_ref.c get_linear_system.c mpflu.c $(LIB_OMP_AVX2) -o test_iterative_ref_omp_avx2

#---------------------------------------%
# Vector bench
#---------------------------------------%
vecbench: vecbench.c 
	$(CC_AVX2) $(INC) -DFVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_f
	$(CC_AVX2) $(INC) -DDVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_d
	$(CC_AVX2) $(INC) -DDDVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_dd
#	$(CC) $(INC) -DTDVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_td
	$(CC_AVX2) $(INC) -DTDVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_td_avx2
	$(CC_AVX2) $(INC) -DTDVEC -DUSE_RTD_ADD vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_tdt
	$(CC_AVX2) $(INC) -DQDVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_qd
	$(CC_AVX2) $(INC) -DDSVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_ds
	$(CC_AVX2) $(INC) -DTSVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_ts
	$(CC_AVX2) $(INC) -DTSVEC -DUSE_RTS_ADD vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_tst
	$(CC_AVX2) $(INC) -DQSVEC vecbench.c  $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o vecbench_qs

vecbench512: vecbench.c 
	$(CC_AVX512) $(INC) -DDVEC vecbench.c  $(BNCMATMUL_LIB_AVX512) $(COMMON_LIB) -lm -o vecbench_d_512
	$(CC_AVX512) $(INC) -DDDVEC vecbench.c  $(BNCMATMUL_LIB_AVX512) $(COMMON_LIB) -lm -o vecbench_dd_512
	$(CC_AVX512) $(INC) -DTDVEC vecbench.c  $(BNCMATMUL_LIB_AVX512) $(COMMON_LIB) -lm -o vecbench_td_avx512
	$(CC_AVX512) $(INC) -DTDVEC -DUSE_RTD_ADD vecbench.c  $(BNCMATMUL_LIB_AVX512) $(COMMON_LIB) -lm -o vecbench_tdt_512
	$(CC_AVX512) $(INC) -DQDVEC vecbench.c  $(BNCMATMUL_LIB_AVX512) $(COMMON_LIB) -lm -o vecbench_qd_512


#---------------------------------------%
# Run all benchmark tests
#---------------------------------------%
allrun: run_matmulbench_mpf run_matmulbench_dd run_matmulbench_qd

allrun_omp: run_matmulbench_mpf_omp run_matmulbench_dd_omp run_matmulbench_qd_omp 

run_matmulbench_d:
	-./matmulbench_d $(CACHE_SIZE) $(MAX_SECONDS)
	-./matmulbench_d_strassen $(CACHE_SIZE) $(MAX_SECONDS)
	-./matmulbench_d_strassen_static2 $(CACHE_SIZE) $(MAX_SECONDS)
	-./matmulbench_d_winograd $(CACHE_SIZE) $(MAX_SECONDS)

run_matmulbench_mpf:
	-./matmulbench_mpf $(MPF_PREC) $(MAX_SECONDS)
	-./matmulbench_mpf_rec $(MPF_PREC) $(MAX_SECONDS)
	-./matmulbench_mpf_block $(MPF_PREC) $(MIN_DIM) $(MAX_SECONDS)
	-./matmulbench_mpf_strassen $(MPF_PREC) $(MIN_DIM) $(MAX_SECONDS)
	-./matmulbench_mpf_winograd $(MPF_PREC) $(MIN_DIM) $(MAX_SECONDS)
