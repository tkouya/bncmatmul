	$(CC_AVX2) $(INC) -c qdlinear.c -o qdlinear_avx2.o
	$(CC_AVX2) -DDEBUG $(INC) matmul_strassen_general_qd.c gtestmat_qd.o qdlinear_avx2.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_qd_avx2
	$(CC_AVX2) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_qd.c gtestmat_qd.o qdlinear_avx2.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_winograd_qd_avx2

strassen_general_qd_omp: matmul_strassen.h matmul_strassen_general_qd_omp.c mpfr_dtq_sd.c  qdlinear.h qdlinear.c
	$(CC) $(INC) -c qdlinear.c -o qdlinear.o
	$(CC) $(OPENMP) $(INC) -c bncomp_linear.c -o bncomp_linear.o
	$(CC) $(INC) -c matmul_strassen_general_qd.c -o matmul_strassen_general_qd.o
	$(CC) -c  -o get_sec.o
	$(CC) $(INC) -c mpfr_dtq_sd.c -o mpfr_dtq_sd.o
#	$(CC) $(INC) -c qdlu.c -o qdlu.o
	$(CC) $(INC) -c gtestmat_qd.c -o gtestmat_qd.o	
	$(CC) $(OPENMP) -DDEBUG $(INC) matmul_strassen_general_qd_omp.c matmul_strassen_general_qd.o gtestmat_qd.o bncomp_linear.o qdlinear.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_qd_omp
