	$(CPP) -DUSE_OZ $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_dd.cc $(LIB) -o matmulbench_dd_oz
#	$(CPP) -DUSE_STRASSEN -DUSE_WINOGRAD $(INC) $(QD_INC) matmulbench_dd.cc $(LIB_WINOGRAD) -o matmulbench_dd_winograd
	$(CPP) $(OPENMP) -DUSE_OMP $(INC) -I$(MPLAPACK_INC_PATH) matmulbench_dd.cc $(LIB_OMP) -o matmulbench_dd_omp
	$(CPP) $(OPENMP) -DUSE_OMP -DUSE_MBLAS $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_dd.cc -L$(MPLAPACK_LIB_PATH) -l$(MPBLAS_LIBNAME)_dd $(LIB_OMP) -o matmulbench_dd_mblas_omp
