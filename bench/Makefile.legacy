matmul_bench_dd: matmulbench_dd.cc
	$(CPP) $(INC) matmulbench_dd.cc $(LIB) -o matmulbench_dd
	$(CPP) -DUSE_MBLAS $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_dd.cc -L$(MPLAPACK_LIB_PATH) -l$(MPBLAS_LIBNAME)_dd $(LIB) -o matmulbench_dd_mblas
	$(CPP) -DUSE_BLOCK $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_dd.cc $(LIB) -o matmulbench_dd_block
	$(CPP) -DUSE_STRASSEN $(INC) -I$(MPLAPACK_INC_PATH) $(QD_INC) matmulbench_dd.cc $(LIB) -o matmulbench_dd_strassen
#	$(CPP) -DUSE_OZ -DOZ_MAX_NUM_DIV=2 $(INC) $(QD_INC) matmulbench_dd.cc $(LIB) -o matmulbench_dd_oz_mnd2
#	$(CPP) -DUSE_OZ -DOZ_MAX_NUM_DIV=4 $(INC) $(QD_INC) matmulbench_dd.cc $(LIB) -o matmulbench_dd_oz_mnd4
