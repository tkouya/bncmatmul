	-./matmulbench_mpf_strassen_omp $(MPF_PREC) $(MIN_DIM) $(OMP_NUM_THREADS) $(MAX_SECONDS)
	-./matmulbench_mpf_winograd_omp $(MPF_PREC) $(MIN_DIM) $(OMP_NUM_THREADS) $(MAX_SECONDS)
