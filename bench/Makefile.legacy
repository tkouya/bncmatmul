#---------------------------------------
# DD / TD / QD (double-double, triple-double, quad-double) bench targets
# (verify mul_ddmatrix / mul_tdmatrix / mul_qdmatrix against an MPFR reference;
#  companions to the bench_{ds,ts,qs}linear below).
# Common defines: 
#---------------------------------------
DTQ_DEFS = 

# Normal (scalar)
bench_ddlinear: bench_ddlinear.cc
	$(CPP) $(DTQ_DEFS) $(INC) bench_ddlinear.cc $(LIB) -o bench_ddlinear
bench_tdlinear: bench_tdlinear.cc
	$(CPP) $(DTQ_DEFS) $(INC) bench_tdlinear.cc $(LIB) -o bench_tdlinear
bench_qdlinear: bench_qdlinear.cc
	$(CPP) $(DTQ_DEFS) $(INC) bench_qdlinear.cc $(LIB) -o bench_qdlinear

# AVX2
bench_ddlinear_avx2: bench_ddlinear.cc
	$(CPP_AVX2) $(DTQ_DEFS) $(INC) bench_ddlinear.cc $(LIB_AVX2) -o bench_ddlinear_avx2
bench_tdlinear_avx2: bench_tdlinear.cc
	$(CPP_AVX2) $(DTQ_DEFS) $(INC) bench_tdlinear.cc $(LIB_AVX2) -o bench_tdlinear_avx2
bench_qdlinear_avx2: bench_qdlinear.cc
	$(CPP_AVX2) $(DTQ_DEFS) $(INC) bench_qdlinear.cc $(LIB_AVX2) -o bench_qdlinear_avx2

# AVX-512
bench_ddlinear_avx512: bench_ddlinear.cc
	$(CPP_AVX512) $(DTQ_DEFS) $(INC) bench_ddlinear.cc $(LIB_AVX512) -o bench_ddlinear_avx512
bench_tdlinear_avx512: bench_tdlinear.cc
	$(CPP_AVX512) $(DTQ_DEFS) $(INC) bench_tdlinear.cc $(LIB_AVX512) -o bench_tdlinear_avx512
bench_qdlinear_avx512: bench_qdlinear.cc
	$(CPP_AVX512) $(DTQ_DEFS) $(INC) bench_qdlinear.cc $(LIB_AVX512) -o bench_qdlinear_avx512

# NEON
bench_ddlinear_neon: bench_ddlinear.cc
	$(CPP_NEON) $(DTQ_DEFS) $(INC) bench_ddlinear.cc $(LIB_NEON) -o bench_ddlinear_neon
bench_tdlinear_neon: bench_tdlinear.cc
	$(CPP_NEON) $(DTQ_DEFS) $(INC) bench_tdlinear.cc $(LIB_NEON) -o bench_tdlinear_neon
bench_qdlinear_neon: bench_qdlinear.cc
	$(CPP_NEON) $(DTQ_DEFS) $(INC) bench_qdlinear.cc $(LIB_NEON) -o bench_qdlinear_neon

# SVE2 (Grace / Neoverse V2 build target — see bncmatmul.inc)
bench_ddlinear_sve2: bench_ddlinear.cc
	$(CPP_SVE2) $(DTQ_DEFS) $(INC) bench_ddlinear.cc $(LIB_SVE2) -o bench_ddlinear_sve2
bench_tdlinear_sve2: bench_tdlinear.cc
	$(CPP_SVE2) $(DTQ_DEFS) $(INC) bench_tdlinear.cc $(LIB_SVE2) -o bench_tdlinear_sve2
bench_qdlinear_sve2: bench_qdlinear.cc
	$(CPP_SVE2) $(DTQ_DEFS) $(INC) bench_qdlinear.cc $(LIB_SVE2) -o bench_qdlinear_sve2

.PHONY: bench_dtq bench_dtq_avx2 bench_dtq_avx512 bench_dtq_neon bench_dtq_sve2 bench_dtq_all
bench_dtq:        bench_ddlinear         bench_tdlinear         bench_qdlinear
bench_dtq_avx2:   bench_ddlinear_avx2    bench_tdlinear_avx2    bench_qdlinear_avx2
bench_dtq_avx512: bench_ddlinear_avx512  bench_tdlinear_avx512  bench_qdlinear_avx512
bench_dtq_neon:   bench_ddlinear_neon    bench_tdlinear_neon    bench_qdlinear_neon
bench_dtq_sve2:   bench_ddlinear_sve2    bench_tdlinear_sve2    bench_qdlinear_sve2
bench_dtq_all:    bench_dtq bench_dtq_avx2 bench_dtq_avx512 bench_dtq_neon bench_dtq_sve2

#---------------------------------------
# DS / TS / QS (float-float, triple-single, quadruple-single) bench targets
# Mirror of matmul_bench_dd / _td / _qd targets above.
#---------------------------------------
# Individual targets — Normal (scalar) version
bench_dslinear: bench_dslinear.cc
	$(CPP) $(INC) bench_dslinear.cc $(LIB) -o bench_dslinear

bench_tslinear: bench_tslinear.cc
	$(CPP) $(INC) bench_tslinear.cc $(LIB) -o bench_tslinear

bench_qslinear: bench_qslinear.cc
	$(CPP) $(INC) bench_qslinear.cc $(LIB) -o bench_qslinear

# Individual targets — AVX2 version
bench_dslinear_avx2: bench_dslinear.cc
	$(CPP_AVX2) $(INC) bench_dslinear.cc $(LIB_AVX2) -o bench_dslinear_avx2

bench_tslinear_avx2: bench_tslinear.cc
	$(CPP_AVX2) $(INC) bench_tslinear.cc $(LIB_AVX2) -o bench_tslinear_avx2

bench_qslinear_avx2: bench_qslinear.cc
	$(CPP_AVX2) $(INC) bench_qslinear.cc $(LIB_AVX2) -o bench_qslinear_avx2

# Individual targets — AVX-512 version
bench_dslinear_avx512: bench_dslinear.cc
	$(CPP_AVX512) $(INC) bench_dslinear.cc $(LIB_AVX512) -o bench_dslinear_avx512

bench_tslinear_avx512: bench_tslinear.cc
	$(CPP_AVX512) $(INC) bench_tslinear.cc $(LIB_AVX512) -o bench_tslinear_avx512

bench_qslinear_avx512: bench_qslinear.cc
	$(CPP_AVX512) $(INC) bench_qslinear.cc $(LIB_AVX512) -o bench_qslinear_avx512

# Individual targets — NEON version
bench_dslinear_neon: bench_dslinear.cc
	$(CPP_NEON) $(INC) bench_dslinear.cc $(LIB_NEON) -o bench_dslinear_neon

bench_tslinear_neon: bench_tslinear.cc
	$(CPP_NEON) $(INC) bench_tslinear.cc $(LIB_NEON) -o bench_tslinear_neon

bench_qslinear_neon: bench_qslinear.cc
	$(CPP_NEON) $(INC) bench_qslinear.cc $(LIB_NEON) -o bench_qslinear_neon

# Individual targets — SVE2 version (Armv9-A, Grace / Neoverse V2 on DGX Spark)
bench_dslinear_sve2: bench_dslinear.cc
	$(CPP_SVE2) $(INC) bench_dslinear.cc $(LIB_SVE2) -o bench_dslinear_sve2

bench_tslinear_sve2: bench_tslinear.cc
	$(CPP_SVE2) $(INC) bench_tslinear.cc $(LIB_SVE2) -o bench_tslinear_sve2

bench_qslinear_sve2: bench_qslinear.cc
	$(CPP_SVE2) $(INC) bench_qslinear.cc $(LIB_SVE2) -o bench_qslinear_sve2

#---------------------------------------
# Umbrella targets — build all three (ds/ts/qs) for a chosen SIMD flavor
#   make -f Makefile.legacy bench_dtqs              # scalar
#   make -f Makefile.legacy bench_dtqs_avx2         # AVX2
#   make -f Makefile.legacy bench_dtqs_avx512       # AVX-512
#   make -f Makefile.legacy bench_dtqs_neon         # NEON
#   make -f Makefile.legacy bench_dtqs_sve2         # SVE2
#   make -f Makefile.legacy bench_dtqs_all          # everything above
#---------------------------------------
.PHONY: bench_dtqs bench_dtqs_avx2 bench_dtqs_avx512 bench_dtqs_neon bench_dtqs_sve2 bench_dtqs_all

bench_dtqs:        bench_dslinear         bench_tslinear         bench_qslinear
bench_dtqs_avx2:   bench_dslinear_avx2    bench_tslinear_avx2    bench_qslinear_avx2
bench_dtqs_avx512: bench_dslinear_avx512  bench_tslinear_avx512  bench_qslinear_avx512
bench_dtqs_neon:   bench_dslinear_neon    bench_tslinear_neon    bench_qslinear_neon
bench_dtqs_sve2:   bench_dslinear_sve2    bench_tslinear_sve2    bench_qslinear_sve2
bench_dtqs_all:    bench_dtqs bench_dtqs_avx2 bench_dtqs_avx512 bench_dtqs_neon bench_dtqs_sve2

# Build both families (dd/td/qd AND ds/ts/qs) for one SIMD flavor / everything
.PHONY: bench_mp bench_mp_avx2 bench_mp_avx512 bench_mp_neon bench_mp_sve2 bench_mp_all
bench_mp:        bench_dtq        bench_dtqs
bench_mp_avx2:   bench_dtq_avx2   bench_dtqs_avx2
bench_mp_avx512: bench_dtq_avx512 bench_dtqs_avx512
bench_mp_neon:   bench_dtq_neon   bench_dtqs_neon
bench_mp_sve2:   bench_dtq_sve2   bench_dtqs_sve2
bench_mp_all:    bench_dtq_all    bench_dtqs_all

# Backwards-compatible aliases for the names previously introduced
bench_dtqslinear:        bench_dtqs
bench_dtqslinear_avx2:   bench_dtqs_avx2
bench_dtqslinear_avx512: bench_dtqs_avx512
bench_dtqslinear_neon:   bench_dtqs_neon
bench_dtqslinear_sve2:   bench_dtqs_sve2

# ----------------------------------------------------------------------------
# OpenMP-parallel Strassen benchmark (serial mul_<prec>matrix_strassen vs.
# parallel _bncomp_mul_<prec>matrix_strassen, all 6 multi-precision layers).
# Needs an OpenMP library: build  'make -C src -f Makefile.legacy omp'  (and
# 'omp_neon' / 'omp_sve2' for the SIMD-tuned variants) first.
#   Usage:  ./bench_strassen_omp [num_threads] [min_dim] [N1,N2,...]
# ----------------------------------------------------------------------------
MP_DEFS_OMP = -DUSE_OMP 

bench_strassen_omp: bench_strassen_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_strassen_omp.cc $(LIB_OMP) -o bench_strassen_omp

bench_strassen_omp_neon: bench_strassen_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP_NEON) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_strassen_omp.cc $(LIB_NEON_OMP) -o bench_strassen_omp_neon

bench_strassen_omp_sve2: bench_strassen_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP_SVE2) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_strassen_omp.cc $(LIB_SVE2_OMP) -o bench_strassen_omp_sve2

bench_strassen_omp_avx2: bench_strassen_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP_AVX2) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_strassen_omp.cc $(LIB_AVX2_OMP) -o bench_strassen_omp_avx2

bench_strassen_omp_avx512: bench_strassen_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP_AVX512) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_strassen_omp.cc $(LIB_AVX512_OMP) -o bench_strassen_omp_avx512

bench_strassen_omp_all: bench_strassen_omp bench_strassen_omp_neon bench_strassen_omp_sve2

# ----------------------------------------------------------------------------
# OpenMP-parallel BLOCK matmul benchmark (sister of bench_strassen_omp).
# Measures serial mul_<prec>matrix_block vs. parallel _bncomp_mul_<prec>matrix_block
# for all 6 multi-precision layers; reports speedup + relative Frobenius error.
#   Usage:  ./bench_block_omp [num_threads] [min_dim] [N1,N2,...]
# ----------------------------------------------------------------------------
bench_block_omp: bench_block_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_block_omp.cc $(LIB_OMP) -o bench_block_omp

bench_block_omp_neon: bench_block_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP_NEON) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_block_omp.cc $(LIB_NEON_OMP) -o bench_block_omp_neon

bench_block_omp_sve2: bench_block_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP_SVE2) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_block_omp.cc $(LIB_SVE2_OMP) -o bench_block_omp_sve2

bench_block_omp_avx2: bench_block_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP_AVX2) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_block_omp.cc $(LIB_AVX2_OMP) -o bench_block_omp_avx2

bench_block_omp_avx512: bench_block_omp.cc ../include/matmul_strassen.h ../include/bncomp.h
	$(CPP_AVX512) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_block_omp.cc $(LIB_AVX512_OMP) -o bench_block_omp_avx512

bench_block_omp_all: bench_block_omp bench_block_omp_neon bench_block_omp_sve2

# ----------------------------------------------------------------------------
# OpenMP-parallel scalar * vector benchmark (cousin of bench_strassen_omp).
# Measures serial cmul_<prec>vector vs. parallel _bncomp_cmul_<prec>vector
# for all 6 multi-precision layers; reports speedup + relative Euclidean error.
#   Usage:  ./bench_cmul_vector_omp [num_threads] [N1,N2,...]
# ----------------------------------------------------------------------------
bench_cmul_vector_omp: bench_cmul_vector_omp.cc ../include/bncomp.h
	$(CPP) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_cmul_vector_omp.cc $(LIB_OMP) -o bench_cmul_vector_omp

bench_cmul_vector_omp_neon: bench_cmul_vector_omp.cc ../include/bncomp.h
	$(CPP_NEON) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_cmul_vector_omp.cc $(LIB_NEON_OMP) -o bench_cmul_vector_omp_neon

bench_cmul_vector_omp_sve2: bench_cmul_vector_omp.cc ../include/bncomp.h
	$(CPP_SVE2) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_cmul_vector_omp.cc $(LIB_SVE2_OMP) -o bench_cmul_vector_omp_sve2

bench_cmul_vector_omp_avx2: bench_cmul_vector_omp.cc ../include/bncomp.h
	$(CPP_AVX2) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_cmul_vector_omp.cc $(LIB_AVX2_OMP) -o bench_cmul_vector_omp_avx2

bench_cmul_vector_omp_avx512: bench_cmul_vector_omp.cc ../include/bncomp.h
	$(CPP_AVX512) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_cmul_vector_omp.cc $(LIB_AVX512_OMP) -o bench_cmul_vector_omp_avx512

bench_cmul_vector_omp_all: bench_cmul_vector_omp bench_cmul_vector_omp_neon bench_cmul_vector_omp_sve2

# ----------------------------------------------------------------------------
# OpenMP-parallel matrix * vector benchmark (cousin of bench_strassen_omp).
# Measures serial mul_<prec>matrix_<prec>vec vs. parallel _bncomp_mul_<prec>matrix_<prec>vec
# for all 6 multi-precision layers; reports speedup + relative Euclidean error.
#   Usage:  ./bench_matvec_omp [num_threads] [N1,N2,...]
# ----------------------------------------------------------------------------
bench_matvec_omp: bench_matvec_omp.cc ../include/bncomp.h
	$(CPP) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_matvec_omp.cc $(LIB_OMP) -o bench_matvec_omp

bench_matvec_omp_neon: bench_matvec_omp.cc ../include/bncomp.h
	$(CPP_NEON) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_matvec_omp.cc $(LIB_NEON_OMP) -o bench_matvec_omp_neon

bench_matvec_omp_sve2: bench_matvec_omp.cc ../include/bncomp.h
	$(CPP_SVE2) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_matvec_omp.cc $(LIB_SVE2_OMP) -o bench_matvec_omp_sve2

bench_matvec_omp_avx2: bench_matvec_omp.cc ../include/bncomp.h
	$(CPP_AVX2) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_matvec_omp.cc $(LIB_AVX2_OMP) -o bench_matvec_omp_avx2

bench_matvec_omp_avx512: bench_matvec_omp.cc ../include/bncomp.h
	$(CPP_AVX512) $(OPENMP) $(MP_DEFS_OMP) $(INC) bench_matvec_omp.cc $(LIB_AVX512_OMP) -o bench_matvec_omp_avx512

bench_matvec_omp_all: bench_matvec_omp bench_matvec_omp_neon bench_matvec_omp_sve2

# remove all bench_{dd,td,qd,ds,ts,qs}linear[_simd] binaries
.PHONY: clean_dtqs clean_dtq clean_mp
clean_dtq:
	-rm -f bench_ddlinear  bench_tdlinear  bench_qdlinear
	-rm -f bench_ddlinear_avx2    bench_tdlinear_avx2    bench_qdlinear_avx2
	-rm -f bench_ddlinear_avx512  bench_tdlinear_avx512  bench_qdlinear_avx512
	-rm -f bench_ddlinear_neon    bench_tdlinear_neon    bench_qdlinear_neon
	-rm -f bench_ddlinear_sve2    bench_tdlinear_sve2    bench_qdlinear_sve2
clean_dtqs:
	-rm -f bench_dslinear  bench_tslinear  bench_qslinear
	-rm -f bench_dslinear_avx2    bench_tslinear_avx2    bench_qslinear_avx2
	-rm -f bench_dslinear_avx512  bench_tslinear_avx512  bench_qslinear_avx512
	-rm -f bench_dslinear_neon    bench_tslinear_neon    bench_qslinear_neon
	-rm -f bench_dslinear_sve2    bench_tslinear_sve2    bench_qslinear_sve2
clean_mp: clean_dtq clean_dtqs

# clear
clean: clean_dtqs clean_dtq
	-rm lu_bench
	-rm lu_bench_dd
	-rm lu_bench_dd_avx2
	-rm lu_bench_dd_block
	-rm lu_bench_dd_block_im_rand
	-rm lu_bench_dd_block_avx2
	-rm lu_bench_dd_oz_mnd*
	-rm lu_bench_qd
	-rm lu_bench_qd_avx2
	-rm lu_bench_qd_block
	-rm lu_bench_qd_block_im_rand
	-rm lu_bench_qd_block_avx2
	-rm lu_bench_qd_oz_mnd*
	-rm clu_bench
	-rm clu_bench_dd
	-rm clu_bench_dd_avx2
	-rm clu_bench_dd_block
	-rm clu_bench_dd_block_avx2
	-rm clu_bench_dd_oz_mnd*
	-rm clu_bench
	-rm clu_bench_td
	-rm clu_bench_td_avx2
	-rm clu_bench_td_block
	-rm clu_bench_td_block_avx2
	-rm clu_bench_td_oz_mnd*
	-rm clu_bench
	-rm clu_bench_qd
	-rm clu_bench_qd_avx2
	-rm clu_bench_qd_block
	-rm clu_bench_qd_block_avx2
	-rm clu_bench_qd_oz_mnd*
	-rm clu_bench_qd_omp*
	-rm matmulbench_dd
	-rm matmulbench_td
	-rm matmulbench_qd
	-rm matmulbench_cdd
	-rm matmulbench_ctd
	-rm matmulbench_cqd
	-rm matvecbench_dd
	-rm matvecbench_cdd
