# include bncmatmul.inc
#include ../icc.inc
#include ../gcc.inc
include ../bncmatmul.inc

#CBLAS_INC = -I/opt/intel/oneapi/mkl/latest/include -DUSE_IMKL
#CBLAS_LIB = -L/opt/intel/oneapi/mkl/latest/lib/intel64 -lmkl_intel_lp64 -lmkl_sequential -lmkl_core 
# completely compile
all: \
	lu_bench lu_bench_dd lu_bench_td lu_bench_qd \
	clu_bench clu_bench_dd clu_bench_td clu_bench_qd \
	lu_bench_omp lu_bench_dd_omp lu_bench_td_omp lu_bench_qd_omp \
	clu_bench_omp clu_bench_dd_omp clu_bench_td_omp clu_bench_qd_omp \
	matmul_bench_dd \
	matmul_bench_qd \
	matmul_bench_td \
	matmulbench_cdd \
	matmulbench_ctd \
	matmulbench_cqd 

avx2: \
	matmul_bench_dd_avx2 \
	matmul_bench_qd_avx2 \
	matmul_bench_td_avx2 \
	matmulbench_cdd_avx2 \
	matmulbench_ctd_avx2 \
	matmulbench_cqd_avx2 

avx512: \
	matmul_bench_dd_avx512 \
	matmul_bench_qd_avx512 \
	matmul_bench_td_avx512 \
	matmulbench_cdd_avx512 \
	matmulbench_ctd_avx512 \
	matmulbench_cqd_avx512 

neon: \
	matmul_bench_dd_neon \
	matmul_bench_qd_neon \
	matmul_bench_td_neon \
	matmulbench_cdd_neon matmulbench_cdd_strassen_neon \
	matmulbench_ctd_neon matmulbench_ctd_strassen_neon \
	matmulbench_cqd_neon matmulbench_cqd_strassen_neon \
	lu_bench_dd_neon clu_bench_dd_neon \
	lu_bench_td_neon clu_bench_td_neon \
	lu_bench_qd_neon clu_bench_qd_neon

# Double Precision
strassen_general: matmul_strassen.h matmul_strassen_general.c
#	$(CC) -DDEBUG $(INC) matmul_strassen_general.c  $(COMMON_LIB) -o strassen_general
#	$(CC) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general.c $(COMMON_LIB) -o strassen_general_winograd
	$(CC) -c $(INC) dlinear.c -o dlinear.o
	$(CC) -DDEBUG $(INC) matmul_strassen_general.c dlinear.o mpfr_dtq_sd.c  $(COMMON_LIB) -o strassen_general
	$(CC) -DDEBUG -DDUSE_WINOGRAD $(INC) matmul_strassen_general.c dlinear.o mpfr_dtq_sd.c  $(COMMON_LIB) -o strassen_general_winograd

strassen_general_avx2: matmul_strassen.h matmul_strassen_general.c
	$(CC_AVX2) -c $(INC) dlinear.c -o dlinear_avx2.o
	$(CC_AVX2) -DDEBUG $(INC) matmul_strassen_general.c dlinear_avx2.o mpfr_dtq_sd.c  $(COMMON_LIB) -o strassen_general_avx2
	$(CC_AVX2) -DDEBUG -DDUSE_WINOGRAD $(INC) matmul_strassen_general.c dlinear_avx2.o mpfr_dtq_sd.c  $(COMMON_LIB) -o strassen_general_winograd_avx2

#strassen_general_omp: matmul_strassen.h matmul_strassen_general_omp.c $(BNCMATMUL_LIBNAME_OMP)
#	$(CC) -DDEBUG $(OPENMP) $(INC) matmul_strassen_general_omp.c $(LIB_OMP) -o strassen_general_omp
#	$(CC) -DDEBUG $(OPENMP) -DUSE_WINOGRAD $(INC) matmul_strassen_general_omp.c $(LIB_OMP) -o strassen_general_winograd_omp

# MPFR
strassen_general_mpf: matmul_strassen.h matmul_strassen_general_mpf.c mpflinear.c 
	$(CC) -DDEBUG $(INC) matmul_strassen_general_mpf.c  $(BNCMATMUL_LIB) $(COMMON_LIB) -o strassen_general_mpf
	$(CC) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_mpf.c  $(BNCMATMUL_LIB) $(COMMON_LIB) -o strassen_general_winograd_mpf

strassen_general_mpf_omp: matmul_strassen.h matmul_strassen_general_mpf_omp.c mpflinear.c  $(BNCMATMUL_LIBNAME_OMP)
	$(CC) $(INC) -c mpflinear.c -o mpflinear.o
	$(CC) -DDEBUG $(OPENMP) $(INC) matmul_strassen_general_mpf_omp.c  mpflinear.o $(BNCMATMUL_LIB_OMP) $(LIB_OMP) $(BNCMATMUL_LIB) $(COMMOM_LIB) -o strassen_general_mpf_omp	
	$(CC) -DDEBUG $(OPENMP) -DUSE_WINOGRAD $(INC) matmul_strassen_general_mpf_omp.c  mpflinear.o $(BNCMATMUL_LIB_OMP) $(LIB_OMP) $(BNCMATMUL_LIB) $(COMMON_LIB) -o strassen_general_winograd_mpf_omp

# Double-double
strassen_general_dd: matmul_strassen.h matmul_strassen_general_dd.c ddlinear.h ddlu.c mpfr_dtq_sd.c  ddlinear.h ddlinear.c mpflinear.h mpflinear.c
	$(CC) $(INC) -c ddlinear.c -o ddlinear.o
	$(CC) $(INC) -c mpflinear.c -o mpflinear.o
	$(CC) -c  -o get_sec.o
	$(CC) $(INC) -c mpfr_dtq_sd.c -o mpfr_dtq_sd.o
	$(CC) $(INC) -c ddlu.c -o ddlu.o
	$(CC) $(INC) -c gtestmat.c -o gtestmat.o
	$(CC) $(INC) -c gtestmat_dd.c -o gtestmat_dd.o
	$(CC) -DDEBUG $(INC) matmul_strassen_general_dd.c ddlinear.o get_sec.o gtestmat_dd.o ddlu.o mpfr_dtq_sd.o mpflinear.o $(COMMON_LIB) -o strassen_general_dd
	$(CC) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_dd.c ddlinear.o get_sec.o gtestmat_dd.o ddlu.o mpfr_dtq_sd.o mpflinear.o $(COMMON_LIB) -o strassen_general_winograd_dd

strassen_general_dd_avx2: matmul_strassen.h matmul_strassen_general_dd.c ddlinear.h ddlu.c mpfr_dtq_sd.c  ddlinear.h ddlinear.c mpflinear.h mpflinear.c
	$(CC_AVX2) $(INC) -c ddlinear.c -o ddlinear_avx2.o
	$(CC_AVX2) -DDEBUG $(INC) matmul_strassen_general_dd.c ddlinear_avx2.o get_sec.o gtestmat_dd.o ddlu.o mpfr_dtq_sd.o mpflinear.o $(COMMON_LIB) -o strassen_general_dd_avx2
	$(CC_AVX2) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_dd.c ddlinear_avx2.o get_sec.o gtestmat_dd.o ddlu.o mpfr_dtq_sd.o mpflinear.o $(COMMON_LIB) -o strassen_general_winograd_dd_avx2

strassen_general_dd_omp: matmul_strassen.h matmul_strassen_general_dd_omp.c matmul_strassen_general_dd_omp.c ddlinear.h ddlu.c bncomp.h bncomp_linear.c mpfr_dtq_sd.c  ddlinear.h ddlinear.c
	$(CC) $(INC) -c ddlinear.c -o ddlinear.o
	$(CC) $(OPENMP) $(INC) -c bncomp_linear.c -o bncomp_linear.o
	$(CC) $(INC) -c matmul_strassen_general_dd.c -o matmul_strassen_general_dd.o
	$(CC) -c  -o get_sec.o
	$(CC) $(INC) -c mpfr_dtq_sd.c -o mpfr_dtq_sd.o
	$(CC) $(INC) -c ddlu.c -o ddlu.o
	$(CC) $(INC) -c gtestmat_dd.c -o gtestmat_dd.o
	$(CC) $(OPENMP) -DDEBUG $(INC) matmul_strassen_general_dd_omp.c matmul_strassen_general_dd.o bncomp_linear.o ddlinear.o get_sec.o gtestmat_dd.o ddlu.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_dd_omp
	$(CC) $(OPENMP) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_dd_omp.c matmul_strassen_general_dd.o bncomp_linear.o ddlinear.o get_sec.o gtestmat_dd.o ddlu.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_winograd_dd_omp

strassen_general_dd_omp_avx2: matmul_strassen.h matmul_strassen_general_dd_omp.c matmul_strassen_general_dd_omp.c ddlinear.h ddlu.c bncomp.h bncomp_linear.c mpfr_dtq_sd.c  ddlinear.h ddlinear.c
	$(CC_AVX2) $(INC) -c ddlinear.c -o ddlinear_avx2.o
	$(CC_AVX2) $(OPENMP) $(INC) -c bncomp_linear.c -o bncomp_linear_avx2.o
	$(CC_AVX2) $(INC) -c matmul_strassen_general_dd.c -o matmul_strassen_general_dd_avx2.o
	$(CC_AVX2) $(OPENMP) -DDEBUG $(INC) matmul_strassen_general_dd_omp.c matmul_strassen_general_dd_avx2.o bncomp_linear_avx2.o ddlinear_avx2.o get_sec.o gtestmat_dd.o ddlu.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_dd_omp_avx2
	$(CC_AVX2) $(OPENMP) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_dd_omp.c matmul_strassen_general_dd_avx2.o bncomp_linear_avx2.o ddlinear_avx2.o get_sec.o gtestmat_dd.o ddlu.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_winograd_dd_omp_avx2

# Triple-double
strassen_general_td: matmul_strassen.h matmul_strassen_general_td.c tdlinear.h tdlu.c gtestmat_td.c mpfr_dtq_sd.c  tdlinear.h tdlinear.c
	$(CC) $(INC) -c tdlinear.c -o tdlinear.o
	$(CC) -c  -o get_sec.o
	$(CC) $(INC) -c mpfr_dtq_sd.c -o mpfr_dtq_sd.o
	#$(CC) $(INC) -c tdlu.c -o tdlu.o
	$(CC) $(INC) -c gtestmat_td.c -o gtestmat_td.o
	$(CC) -DDEBUG $(INC) matmul_strassen_general_td.c gtestmat_td.o tdlinear.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_td
	$(CC) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_td.c gtestmat_td.o tdlinear.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_winograd_td

strassen_general_td_avx2: matmul_strassen.h matmul_strassen_general_td.c tdlinear.h tdlu.c gtestmat_td.c mpfr_dtq_sd.c  tdlinear.h tdlinear.c
	$(CC_AVX2) $(INC) -c tdlinear.c -o tdlinear_avx2.o
	$(CC_AVX2) -DDEBUG $(INC) matmul_strassen_general_td.c gtestmat_td.o tdlinear_avx2.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_td_avx2
	$(CC_AVX2) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_td.c gtestmat_td.o tdlinear_avx2.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_winograd_td_avx2

strassen_general_td_omp: matmul_strassen.h matmul_strassen_general_td_omp.c tdlinear.h tdlu.c gtestmat_td.c mpfr_dtq_sd.c  tdlinear.h tdlinear.c
	$(CC) $(INC) -c tdlinear.c -o tdlinear.o
	$(CC) $(OPENMP) $(INC) -c bncomp_linear.c -o bncomp_linear.o
	$(CC) $(INC) -c matmul_strassen_general_td.c -o matmul_strassen_general_td.o
	$(CC) -c  -o get_sec.o
	$(CC) $(INC) -c mpfr_dtq_sd.c -o mpfr_dtq_sd.o
#	$(CC) $(INC) -c tdlu.c -o tdlu.o
	$(CC) $(INC) -c gtestmat_td.c -o gtestmat_td.o
	$(CC) $(OPENMP) -DDEBUG $(INC) matmul_strassen_general_td_omp.c matmul_strassen_general_td.o bncomp_linear.o gtestmat_td.o tdlinear.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_td_omp
	$(CC) $(OPENMP) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_td_omp.c matmul_strassen_general_td.o bncomp_linear.o gtestmat_td.o tdlinear.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_winograd_td_omp

strassen_general_td_omp_avx2: matmul_strassen.h matmul_strassen_general_td_omp.c tdlinear.h tdlu.c gtestmat_td.c mpfr_dtq_sd.c  tdlinear.h tdlinear.c
	$(CC_AVX2) $(INC) -c tdlinear.c -o tdlinear_avx2.o
	$(CC_AVX2) $(OPENMP) $(INC) -c bncomp_linear.c -o bncomp_linear_avx2.o
	$(CC_AVX2) $(INC) -c matmul_strassen_general_td.c -o matmul_strassen_general_td_avx2.o
	$(CC_AVX2) $(OPENMP) -DDEBUG $(INC) matmul_strassen_general_td_omp.c matmul_strassen_general_td_avx2.o bncomp_linear_avx2.o gtestmat_td.o tdlinear_avx2.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_td_omp_avx2
	$(CC_AVX2) $(OPENMP) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_td_omp.c matmul_strassen_general_td_avx2.o bncomp_linear_avx2.o gtestmat_td.o tdlinear_avx2.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_winograd_td_omp_avx2


# Quad-double
strassen_general_qd: matmul_strassen.h matmul_strassen_general_qd.c mpfr_dtq_sd.c  qdlinear.h qdlinear.c
	$(CC) $(INC) -c qdlinear.c -o qdlinear.o
	$(CC) -c  -o get_sec.o
	$(CC) $(INC) -c mpfr_dtq_sd.c -o mpfr_dtq_sd.o
#	$(CC) $(INC) -c qdlu.c -o qdlu.o
	$(CC) $(INC) -c gtestmat_qd.c -o gtestmat_qd.o	
	$(CC) -DDEBUG $(INC) matmul_strassen_general_qd.c gtestmat_qd.o qdlinear.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_qd
	$(CC) -DDEBUG -DUSE_WINOGRAD $(INC) matmul_strassen_general_qd.c gtestmat_qd.o qdlinear.o get_sec.o mpfr_dtq_sd.o $(COMMON_LIB) -o strassen_general_winograd_qd

