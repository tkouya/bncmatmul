include ../bncmatmul.inc


all: \
	generic

generic: \
	matmul_strassen_lib \
	matmul_strassen_lib_omp \
	matmul_winograd_lib \
	matmul_winograd_lib_omp

avx2: \
	matmul_strassen_lib_avx2 \
	matmul_strassen_lib_omp_avx2 \
	matmul_winograd_lib_avx2 \
	matmul_winograd_lib_omp_avx2

neon: \
	matmul_strassen_lib_neon \
	matmul_strassen_lib_omp_neon

sve2: \
	matmul_strassen_lib_sve2 \
	matmul_strassen_lib_omp_sve2

avx512: \
	matmul_strassen_lib_avx512 \
	matmul_strassen_lib_omp_avx512 \
	matmul_winograd_lib_avx512 \
	matmul_winograd_lib_omp_avx512 \
#	vecbench512

