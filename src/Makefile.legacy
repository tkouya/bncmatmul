# -----------------
# Winograd + OpenMP
# -----------------
matmul_winograd_lib_omp:
	$(CC) $(OPENMP) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_dd_omp.c -o matmul_strassen_general_dd_$(WINOGRAD)_omp.o
	$(CC) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_td_omp.c -o matmul_strassen_general_td_$(WINOGRAD)_omp.o
	$(CC) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_qd_omp.c -o matmul_strassen_general_qd_$(WINOGRAD)_omp.o
	$(CC) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c bncomp_linear.c -o bncomp_linear_$(WINOGRAD).o
	$(CC) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c bncomp_linear_double.c -o bncomp_linear_double_$(WINOGRAD).o
#	$(CC) $(OPENMP) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c bncomp_block_linear.c -o bncomp_block_linear_$(WINOGRAD).o
#	$(CC) $(OPENMP) $(INC) -DUSE_WINOGRAD -c matmul_strassen_general_mpf_omp.c -o matmul_strassen_general_mpf_$(WINOGRAD)_omp.o
	$(CC) $(OPENMP) $(INC) -DUSE_WINOGRAD -c matmul_strassen_general_omp.c -o matmul_strassen_general_$(WINOGRAD)_omp.o
	$(AR) $(LIBPATH)/$(BNCMATMUL_LIBNAME_WINOGRAD_OMP) bncomp_linear_$(WINOGRAD).o
	$(AR) $(LIBPATH)/$(BNCMATMUL_LIBNAME_WINOGRAD_OMP) bncomp_linear_double_$(WINOGRAD).o
#	$(AR) $(LIBPATH)/$(BNCMATMUL_LIBNAME_WINOGRAD_OMP) bncomp_block_linear_$(WINOGRAD).o
	$(AR) $(LIBPATH)/$(BNCMATMUL_LIBNAME_WINOGRAD_OMP) matmul_strassen_general_$(WINOGRAD)_omp.o
	$(AR) $(LIBPATH)/$(BNCMATMUL_LIBNAME_WINOGRAD_OMP) matmul_strassen_general_dd_$(WINOGRAD)_omp.o
	$(AR) $(LIBPATH)/$(BNCMATMUL_LIBNAME_WINOGRAD_OMP) matmul_strassen_general_td_$(WINOGRAD)_omp.o
	$(AR) $(LIBPATH)/$(BNCMATMUL_LIBNAME_WINOGRAD_OMP) matmul_strassen_general_qd_$(WINOGRAD)_omp.o
	$(CC_DLL) $(OPENMP) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_dd_omp.c -o matmul_strassen_general_dd_$(WINOGRAD)_omp.o
	$(CC_DLL) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_td_omp.c -o matmul_strassen_general_td_$(WINOGRAD)_omp.o
	$(CC_DLL) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_qd_omp.c -o matmul_strassen_general_qd_$(WINOGRAD)_omp.o
	$(CC_DLL) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c bncomp_linear.c -o bncomp_linear_$(WINOGRAD).o
	$(CC_DLL) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c bncomp_linear_double.c -o bncomp_linear_double_$(WINOGRAD).o
#	$(CC_DLL) $(OPENMP) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c bncomp_block_linear.c -o bncomp_block_linear_$(WINOGRAD).o
	$(CC_DLL) $(OPENMP) $(INC) -DUSE_WINOGRAD -c matmul_strassen_general_omp.c -o matmul_strassen_general_$(WINOGRAD)_omp.o
	$(AR_DLL) bncomp_linear_$(WINOGRAD).o bncomp_linear_double_$(WINOGRAD).o matmul_strassen_general_$(WINOGRAD)_omp.o matmul_strassen_general_dd_$(WINOGRAD)_omp.o matmul_strassen_general_td_$(WINOGRAD)_omp.o matmul_strassen_general_qd_$(WINOGRAD)_omp.o $(COMMON_LIB) -o $(DLLPATH)/$(BNCMATMUL_DLLNAME_WINOGRAD_OMP)

