	$(CC_DLL_AVX512) $(OPENMP) $(INC) -DUSE_WINOGRAD -c matmul_strassen_general_mpf_omp.c -o matmul_strassen_general_mpf_$(WINOGRAD)_omp_avx512.o
	$(AR_DLL) bncomp_linear_$(WINOGRAD)_avx512.o bncomp_linear_double_$(WINOGRAD)_avx512.o matmul_strassen_general_mpf_$(WINOGRAD)_omp_avx512.o matmul_strassen_general_dd_$(WINOGRAD)_omp_avx512.o matmul_strassen_general_td_$(WINOGRAD)_omp_avx512.o matmul_strassen_general_qd_$(WINOGRAD)_omp_avx512.o $(COMMON_LIB) -o $(DLLPATH)/$(BNCMATMUL_DLLNAME_WINOGRAD_OMP_AVX512)

#---------------------------------------%
# CUDA (Experimental)
#---------------------------------------%
libgqd: $(GQD_INC_DIR)/inline.cu $(GQD_INC_DIR)/common.cu $(GQD_INC_DIR)/gdd_basic.cu $(GQD_INC_DIR)/gdd_sqrt.cu $(GQD_INC_DIR)/gdd_exp.cu $(GQD_INC_DIR)/gdd_log.cu $(GQD_INC_DIR)/gdd_sincos.cu $(GQD_INC_DIR)/gqd_basic.cu $(GQD_INC_DIR)/gqd_sqrt.cu $(GQD_INC_DIR)/gqd_exp.cu $(GQD_INC_DIR)/gqd_log.cu $(GQD_INC_DIR)/gqd_sincos.cu
	$(RM) libgqd.a
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/common.cu -o common.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/inline.cu -o inline.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gdd_basic.cu -o gdd_basic.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gdd_sqrt.cu -o gdd_sqrt.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gdd_exp.cu -o gdd_exp.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gdd_log.cu -o gdd_log.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gdd_sincos.cu -o gdd_sincos.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gqd_basic.cu -o gqd_basic.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gqd_sqrt.cu -o gqd_sqrt.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gqd_exp.cu -o gqd_exp.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gqd_log.cu -o gqd_log.o
	$(NVCC) $(INC) $(GQD_INC) -dc $(GQD_INC_DIR)/gqd_sincos.cu -o gqd_sincos.o
	$(NVCC) $(INC) $(GQD_INC) -dlink inline.o common.o gdd_basic.o gdd_sqrt.o gdd_exp.o gdd_log.o gdd_sincos.o gqd_basic.o gqd_sqrt.o gqd_exp.o gqd_log.o gqd_sincos.o -o libgqd.a

gqd: gddlinear.cu gddlinear_original.cu gddlinear_test.cc # libgqd
	$(NVCC) $(INC) $(GQD_INC) -D__INCLUDE_GQD_CU__ -c gddlinear_original.cu -o gddlinear_original.o
	$(CPP) $(INC) $(GQD_INC) gddlinear_test.cc gddlinear_original.o ddlinear_original.o $(GQD_LIB) $(LIB) -o gddlinear_test

strassen_general_gdd: matmul_strassen.h matmul_strassen_general_gdd.cc matmul_strassen_general_gdd.cu gddlinear_original.cu bncuda.h bncuda_linear_cublas.c
	$(NVCC) $(INC) $(GQD_INC) -D__INCLUDE_GQD_CU__ -dc gddlinear_original.cu -o gddlinear_original.o
	$(NVCC) -DUSE_DDLINEAR -DUSE_CUDA $(INC) $(GQD_INC) -dc matmul_strassen_general_gdd.cu -o matmul_strassen_general_gdd.o
	$(NVCC) -dlink matmul_strassen_general_gdd.o gddlinear_original.o -o dlink.o
	$(CPP) -DDEBUG -DUSE_DDLINEAR -DUSE_CUDA $(OPENMP) $(INC) $(GQD_INC) matmul_strassen_general_gdd.cc matmul_strassen_general_gdd.o gddlinear_original.o dlink.o ddlinear_original.o bncuda_linear_cublas.c $(BNCMATMUL_LIB_CC_OMP) $(LIB) $(QD_LIB) $(GQD_LIB) -o strassen_general_gdd
	$(CPP) -DDEBUG -DUSE_DDLINEAR -DUSE_CUDA -DUSE_WINOGRAD $(OPENMP) $(INC) $(GQD_INC) matmul_strassen_general_gdd.cc matmul_strassen_general_gdd.o gddlinear_original.o dlink.o ddlinear_original.o bncuda_linear_cublas.c $(BNCMATMUL_LIB_CC_OMP) $(LIB) $(QD_LIB) $(GQD_LIB) -o strassen_general_winograd_gdd

strassen_general_gqd: matmul_strassen.h matmul_strassen_general_gqd.cc matmul_strassen_general_gqd.cu gddlinear_original.cu bncuda.h bncuda_linear_cublas.c
	$(NVCC) $(INC) $(GQD_INC) -D__INCLUDE_GQD_CU__ -dc gddlinear_original.cu -o gddlinear_original.o
	$(NVCC) -DUSE_DDLINEAR -DUSE_CUDA $(INC) $(GQD_INC) -dc matmul_strassen_general_gqd.cu -o matmul_strassen_general_gqd.o
	$(NVCC) -dlink matmul_strassen_general_gqd.o gddlinear_original.o -o qlink.o
	$(CPP) -DDEBUG -DUSE_DDLINEAR -DUSE_CUDA $(OPENMP) $(INC) $(GQD_INC) matmul_strassen_general_gqd.cc matmul_strassen_general_gqd.o gddlinear_original.o qlink.o ddlinear_original.o bncuda_linear_cublas.c $(BNCMATMUL_LIB_CC_OMP) $(LIB) $(QD_LIB) $(GQD_LIB) -o strassen_general_gqd
	$(CPP) -DDEBUG -DUSE_DDLINEAR -DUSE_CUDA -DUSE_WINOGRAD $(OPENMP) $(INC) $(GQD_INC) matmul_strassen_general_gqd.cc matmul_strassen_general_gqd.o gddlinear_original.o qlink.o ddlinear_original.o bncuda_linear_cublas.c $(BNCMATMUL_LIB_CC_OMP) $(LIB) $(QD_LIB) $(GQD_LIB) -o strassen_general_winograd_gqd

#---------------------------------------%
# librdd.so
#---------------------------------------%
librdd: ../include/rdd.h ../python/rdd.c mpfr_dtq_sd.c
#	$(CC) -c -I./ python/rdd.c
#	$(CC_DLL) -I./ -shared ../python/rdd.c mpfr_dtq_sd.c -lc -o ../python/librdd.so -lm
	$(CC_DLL) -I./ $(INC) -c ../python/rdd.c -o rdd.o
	$(CC_DLL) $(INC) -c mpfr_dtq_sd.c -o mpfr_dtq_sd.o 
	$(CC_DLL) $(INC) -c bnc_common_func.c -o bnc_common_func.o 
	$(AR_DLL) rdd.o mpfr_dtq_sd.o bnc_common_func.o $(LIB) -o ../python/librdd.so
	$(CC_DLL) -I./ $(INC) -c ../python/rcdd.c -o rcdd.o
	$(AR_DLL) rcdd.o mpfr_dtq_sd.o bnc_common_func.o $(COMMON_LIB) -o ../python/librcdd.so

#librcdd: ../include/rcdd.h ../python/rcdd.c
#	$(CC) -c -I./ python/rdd.c
#	$(CC_DLL) -I./ -shared ../python/rcdd.c -lc -o ../python/librcdd.so -lm

#---------------------------------------%
# Ozaki Scheme
#---------------------------------------%
oz_scheme: oz_scheme.c dd_oz_scheme.c td_oz_scheme.c qd_oz_scheme.c mpf_oz_scheme.c
	$(CC) -DDEBUG $(INC) oz_scheme.c $(BNCMATMUL_LIB) $(COMMON_LIB) -lm -o oz_scheme
	$(CC) -DDEBUG $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_MPFLINEAR dd_oz_scheme.c $(BNCMATMUL_LIB) $(COMMON_LIB) -lm -o dd_oz_scheme
	$(CC) -DDEBUG $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_MPFLINEAR td_oz_scheme.c $(BNCMATMUL_LIB) $(COMMON_LIB) -lm -o td_oz_scheme
	$(CC) -DDEBUG  $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_MPFLINEAR qd_oz_scheme.c $(BNCMATMUL_LIB) $(COMMON_LIB) -lm -o qd_oz_scheme
	$(CC) -DDEBUG  $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_MPFLINEAR mpf_oz_scheme.c $(BNCMATMUL_LIB) $(COMMON_LIB) -lm -o mpf_oz_scheme

oz_scheme_avx2:oz_scheme.c dd_oz_scheme.c td_oz_scheme.c qd_oz_scheme.c mpf_oz_scheme.c
#	$(CC) $(INC) oz_scheme.c $(BNCMATMUL_LIB) $(COMMON_LIB) -lm -o oz_scheme
	$(CC_AVX2) -DDEBUG $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_MPFLINEAR dd_oz_scheme.c $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o dd_oz_scheme_avx2
	$(CC_AVX2) -DDEBUG $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_MPFLINEAR td_oz_scheme.c $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o td_oz_scheme_avx2
	$(CC_AVX2) -DDEBUG $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_MPFLINEAR qd_oz_scheme.c $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o qd_oz_scheme_avx2
	$(CC_AVX2) -DDEBUG $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_MPFLINEAR mpf_oz_scheme.c $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o mpf_oz_scheme_avx2

oz_scheme_imkl:oz_scheme.c dd_oz_scheme.c td_oz_scheme.c qd_oz_scheme.c mpf_oz_scheme.c
#	$(CC) $(INC) oz_scheme.c $(BNCMATMUL_LIB) $(COMMON_LIB) -lm -o oz_scheme
	$(CC_AVX2) -DDEBUG $(COMMON_INC) $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_MPFLINEAR dd_oz_scheme.c $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o dd_oz_scheme_imkl
	$(CC_AVX2) -DDEBUG $(COMMON_INC) $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_MPFLINEAR td_oz_scheme.c $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o td_oz_scheme_imkl
	$(CC_AVX2) -DDEBUG $(COMMON_INC) $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_MPFLINEAR qd_oz_scheme.c $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o qd_oz_scheme_imkl
	$(CC_AVX2) -DDEBUG $(COMMON_INC) $(INC) -DUSE_GMP -DUSE_MPFR -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_MPFLINEAR mpf_oz_scheme.c $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB) -lm -o mpf_oz_scheme_imkl

#---------------------------------------%

# Delete all binaries and temporary files
#---------------------------------------%
clean:
	-rm *.o
	-rm *.a
	-rm *.so
	-rm python/*.so
	-rm *.optrpt # for Intel Compiler
# CUDA
	-rm strassen_general_gdd
	-rm strassen_general_gqd
	-rm strassen_general_winograd_gdd
	-rm strassen_general_winograd_gqd
# oz_scheme
	-rm oz_scheme
	-rm dd_oz_scheme
	-rm td_oz_scheme
	-rm qd_oz_scheme	
	-rm mpf_oz_scheme
	-rm dd_oz_scheme_avx2
	-rm td_oz_scheme_avx2
	-rm qd_oz_scheme_avx2	
	-rm mpf_oz_scheme_avx2

#---------------------------------------%
# librdtq.so : DLL-ready flat API (rdtq_func.c + elem_vector.c) for
#              Python/ctypes consumers (see python/test_rdtq.py)
#---------------------------------------%
librdtq: ../include/rdtq_func.h rdtq_func.c elem_vector.c
	$(CC_DLL) $(INC) -c rdtq_func.c -o rdtq_func_pic.o
	$(CC_DLL) $(INC) -c elem_vector.c -o elem_vector_pic.o
	$(CC_DLL) -shared rdtq_func_pic.o elem_vector_pic.o -o ../python/librdtq.so -lm

librdtq_neon: ../include/rdtq_func.h rdtq_func.c elem_vector.c
	$(CC_DLL_NEON) $(INC) -c rdtq_func.c -o rdtq_func_pic_neon.o
	$(CC_DLL_NEON) $(INC) -c elem_vector.c -o elem_vector_pic_neon.o
	$(CC_DLL_NEON) -shared rdtq_func_pic_neon.o elem_vector_pic_neon.o -o ../python/librdtq_neon.so -lm
