# ---------------
# OpenMP + AVX512
# ---------------
matmul_strassen_lib_omp_avx512:
	$(CC_AVX512) $(OPENMP) $(INC) -c dka_omp.c -o dka_omp_avx512.o
	$(CC_AVX512) $(OPENMP) $(INC) -c bncold_dka_omp.c -o bncold_dka_omp_avx512.o
	$(CC_AVX512) $(OPENMP) -DUSE_DDLINEAR $(INC) -c matmul_strassen_general_dd_omp.c -o matmul_strassen_general_dd_omp_avx512.o
	$(CC_AVX512) $(OPENMP) -DUSE_DSLINEAR $(INC) -c matmul_strassen_general_ds_omp.c -o matmul_strassen_general_ds_omp_avx512.o
	$(CC_AVX512) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR $(INC) -c matmul_strassen_general_td_omp.c -o matmul_strassen_general_td_omp_avx512.o
	$(CC_AVX512) $(OPENMP) -DUSE_DSLINEAR -DUSE_TSLINEAR -DUSE_QSLINEAR $(INC) -c matmul_strassen_general_ts_omp.c -o matmul_strassen_general_ts_omp_avx512.o
	$(CC_AVX512) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR $(INC) -c matmul_strassen_general_qd_omp.c -o matmul_strassen_general_qd_omp_avx512.o
