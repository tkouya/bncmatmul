# -----------------
# Winograd
# -----------------
matmul_winograd_lib:
	$(CC) $(INC) -c bnc_common_func.c -o bnc_common_func_$(WINOGRAD).o
#	$(CC) $(INC) -c complex.c -o complex_$(WINOGRAD).o
#	$(CC) $(INC) -c clinear.c -o clinear_$(WINOGRAD).o
	$(CC) $(INC) -c clu.c -o clu_$(WINOGRAD).o
	$(CC) $(INC) -c cdlinear.c -o cdlinear_$(WINOGRAD).o
#	$(CC) $(INC) -c cdlu.c -o cdlu_$(WINOGRAD).o
	$(CC) $(INC) -c cmpflinear.c -o cmpflinear_$(WINOGRAD).o
#	$(CC) $(INC) -c cmpflu.c -o cmpflu_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_dd.c -o matmul_strassen_general_dd_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_cdd.c -o matmul_strassen_general_cdd_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_td.c -o matmul_strassen_general_td_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c matmul_strassen_general_qd.c -o matmul_strassen_general_qd_$(WINOGRAD).o
	$(CC) -DUSE_WINOGRAD $(INC) -c flinear.c -o flinear_$(WINOGRAD).o
	$(CC) -DUSE_WINOGRAD $(INC) -c dlinear.c -o dlinear_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c cddlinear.c -o cddlinear_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c ddlinear.c -o ddlinear_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_WINOGRAD $(INC) -c tdlinear.c -o tdlinear_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c qdlinear.c -o qdlinear_$(WINOGRAD).o
	$(CC) $(INC) -c mpflinear.c -o mpflinear_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c ddlu.c -o ddlu_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c gtestmat_dd.c -o gtestmat_dd_$(WINOGRAD).o
	$(CC) $(INC) -c get_sec.c -o get_sec_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c benchmark_tools_dd.c -o benchmark_tools_dd_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR -DUSE_WINOGRAD $(INC) -c fread_write.c -o fread_write_$(WINOGRAD).o
	$(CC) -DUSE_DDLINEAR -DUSE_WINOGRAD $(INC) -c mpfr_dtq_sd.c -o mpfr_dtq_sd_$(WINOGRAD).o
	$(CC) $(INC) -c get_sec.c -o get_sec_$(WINOGRAD).o
	$(CC) $(INC) -DUSE_WINOGRAD -c benchmark_tools.c -o benchmark_tools_$(WINOGRAD).o
	$(CC) $(INC) -DUSE_WINOGRAD -c matmul_strassen_general.c -o matmul_strassen_general_$(WINOGRAD).o
	$(CC) $(INC) -DUSE_WINOGRAD -c matmul_strassen_general_mpf.c -o matmul_strassen_general_mpf_$(WINOGRAD).o
	$(CC) $(INC) -DUSE_WINOGRAD -c matmul_strassen_general_mpc.c -o matmul_strassen_general_mpc_$(WINOGRAD).o
