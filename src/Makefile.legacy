# ---------------
# OpenMP + SVE2 (Armv9-A, Grace / Neoverse V2)
# ---------------
matmul_strassen_lib_omp_sve2:
	$(CC_SVE2) $(OPENMP) $(INC) -c dka_omp.c -o dka_omp_sve2.o
