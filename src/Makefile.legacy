matmul_strassen_lib_omp:
	$(CC) $(OPENMP) $(INC) -c dka_omp.c -o dka_omp.o
	$(CC) $(OPENMP) $(INC) -c bncold_dka_omp.c -o bncold_dka_omp.o
	$(CC) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR $(INC) -c matmul_strassen_general_omp.c -o matmul_strassen_general_omp.o
	$(CC) $(OPENMP) -DUSE_DDLINEAR -DUSE_TDLINEAR -DUSE_QDLINEAR $(INC) -c matmul_strassen_general_mpc_omp.c -o matmul_strassen_general_mpc_omp.o
	$(CC) $(OPENMP) -DUSE_DDLINEAR $(INC) -c matmul_strassen_general_dd_omp.c -o matmul_strassen_general_dd_omp.o
	$(CC) $(OPENMP) -DUSE_DSLINEAR $(INC) -c matmul_strassen_general_ds_omp.c -o matmul_strassen_general_ds_omp.o
