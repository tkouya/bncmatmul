#
# DO NOT EDIT directly: edit bncmatmul.inc.in (or re-run configure).
#---------------------------------------

#---------------------------------------
# Build tool detected by configure
#---------------------------------------
BUILD_TOOL = gcc

#---------------------------------------
# Optimization flags
#---------------------------------------
BNCMM_OPT_CFLAGS   = -O3 -ffp-contract=off
BNCMM_OPT_CXXFLAGS = -O3 -ffp-contract=off

#---------------------------------------
# GMP / MPFR / MPC (detected by configure)
#---------------------------------------
GMP_INC      =  -DUSE_GMP
GMP_LIB_PATH = 
GMP_LIB      = -lgmp
MPFR_INC     = $(GMP_INC)  -DUSE_MPFR
MPFR_LIB     =  -lmpfr $(GMP_LIB_PATH) $(GMP_LIB)
MPC_INC      = $(MPFR_INC) 
MPC_LIB      =  -lmpc $(MPFR_LIB) -lm

#---------------------------------------
# Bailey's QD (detected by configure)
#---------------------------------------
QD_INC = 
QD_LIB =  -lqd

#---------------------------------------
# OpenBLAS (optional; detected by configure via --with-openblas)
#
# When enabled, OPENBLAS_INC carries -DUSE_OPENBLAS (plus the -I that makes
# <cblas.h> resolve), which switches the Ozaki-scheme routines over to
# cblas_dgemm()/cblas_dgemv() for their inner double-precision products.
# Both variables are empty when OpenBLAS was not requested/found.
#---------------------------------------
OPENBLAS_INC = -I/opt/OpenBLAS/include -DUSE_OPENBLAS
OPENBLAS_LIB = -L/opt/OpenBLAS/lib -Wl,-rpath,/opt/OpenBLAS/lib -lopenblas

# Names used by Makefile.legacy for a CBLAS backend (was Intel MKL there).
CBLAS_INC = $(OPENBLAS_INC)
CBLAS_LIB = $(OPENBLAS_LIB)

#---------------------------------------
# C / C++ compilers (configure-detected)
#---------------------------------------
CC_ONLY  = gcc
CPP_ONLY = g++

# Generic
CC       = gcc $(BNCMM_OPT_CFLAGS)
CC_DLL   = gcc $(BNCMM_OPT_CFLAGS) -fPIC
CPP      = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS)
CPP_DLL  = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS) -fPIC

# x86 256-bit SIMD (AVX2)
CC_AVX2      = gcc $(BNCMM_OPT_CFLAGS) 
CC_DLL_AVX2  = gcc $(BNCMM_OPT_CFLAGS)  -fPIC
CPP_AVX2     = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS) 
CPP_DLL_AVX2 = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS)  -fPIC

# x86 512-bit SIMD (AVX-512)
CC_AVX512      = gcc $(BNCMM_OPT_CFLAGS) 
CC_DLL_AVX512  = gcc $(BNCMM_OPT_CFLAGS)  -fPIC
CPP_AVX512     = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS) 
CPP_DLL_AVX512 = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS)  -fPIC

# Arm 128-bit SIMD (NEON)
CC_NEON      = gcc $(BNCMM_OPT_CFLAGS) -mcpu=cortex-a76 -DBNC_ENABLE_NEON
CC_DLL_NEON  = gcc $(BNCMM_OPT_CFLAGS) -mcpu=cortex-a76 -DBNC_ENABLE_NEON -fPIC
CPP_NEON     = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS) -mcpu=cortex-a76 -DBNC_ENABLE_NEON
CPP_DLL_NEON = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS) -mcpu=cortex-a76 -DBNC_ENABLE_NEON -fPIC

# Arm SVE2 build target (Armv9-A; Grace / Neoverse V2 on DGX Spark).
# -mcpu=neoverse-v2 -DBNC_ENABLE_SVE2 -DBNC_ENABLE_NEON should contain -mcpu=neoverse-v2 -DBNC_ENABLE_SVE2 -DBNC_ENABLE_NEON.
# True VL-agnostic SVE2 path: -DBNC_ENABLE_SVE2 selects the SVE2 intrinsic
# branches in src/*linear.c / src/bncomp_linear_*.c; -DBNC_ENABLE_NEON is kept
# so any layer that only has a NEON branch still vectorizes (the #if/#elif
# ordering puts SVE2 first).  No -msve-vector-bits=N — the binary runs on
# ANY SVE2 VL (128, 256, 512, ... bits).
CC_SVE2      = gcc $(BNCMM_OPT_CFLAGS) -mcpu=neoverse-v2 -DBNC_ENABLE_SVE2 -DBNC_ENABLE_NEON
CC_DLL_SVE2  = gcc $(BNCMM_OPT_CFLAGS) -mcpu=neoverse-v2 -DBNC_ENABLE_SVE2 -DBNC_ENABLE_NEON -fPIC
CPP_SVE2     = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS) -mcpu=neoverse-v2 -DBNC_ENABLE_SVE2 -DBNC_ENABLE_NEON
CPP_DLL_SVE2 = g++ -std=c++17 $(BNCMM_OPT_CXXFLAGS) -mcpu=neoverse-v2 -DBNC_ENABLE_SVE2 -DBNC_ENABLE_NEON -fPIC

#---------------------------------------
# Archiver / shared-lib linker
#---------------------------------------
AR     = ar rc
AR_DLL = gcc -shared

#---------------------------------------
# OpenMP (configure-detected)
#---------------------------------------
OPENMP    = -DUSE_OMP -fopenmp
OPENMPLIB = -fopenmp
# Number of threads (used by benchmarks)
OPENMP_NUM_THREADS = 4

#---------------------------------------
# Common include / link flags
#---------------------------------------
COMMON_INC = $(QD_INC) $(MPC_INC) $(OPENBLAS_INC) -DUSE_TD_BF -DUSE_QD_BF -DUSE_TS_BF -DUSE_QS_BF
COMMON_LIB = $(MPC_LIB) -lpthread $(QD_LIB) $(OPENBLAS_LIB) -lstdc++

#---------------------------------------
# Install prefix (configure-controlled)
#---------------------------------------
PREFIX = /usr/local

#---------------------------------------
# Version / package directory
#---------------------------------------
VERSION = 0.24
BNCMATMUL_PREFIX = bncmatmul-$(VERSION)

#---------------------------------------
# Directory layout
#---------------------------------------
LIBPATH     = ..
EXEPATH     = test
SRCPATH     = src
INCPATH     = include
DLLPATH     = ../python
PYTHON      = python
SPARSEPATH  = $(SRCPATH)/sparse
MMPATH      = $(SRCPATH)/mm
BNCPACKPATH = $(SRCPATH)/bncpack
MPIPATH     = $(SRCPATH)/mpi
DOC         = doc
TEST        = test
BENCH       = bench

#---------------------------------------
# Library naming
#---------------------------------------
BNCMATMUL_INC     = -I../$(INCPATH)
BNCMATMUL_LIBPATH = ../
BNCMATMUL_DLLPATH = ../$(DLLPATH)

# generic
BNCMATMUL_LIBNAME_SUFFIX     = $(BNCMATMUL_PREFIX)
BNCMATMUL_LIBNAME_OMP_SUFFIX = $(BNCMATMUL_PREFIX)-omp
BNCMATMUL_LIBNAME            = lib$(BNCMATMUL_LIBNAME_SUFFIX).a
BNCMATMUL_LIBNAME_OMP        = lib$(BNCMATMUL_LIBNAME_OMP_SUFFIX).a
BNCMATMUL_DLLNAME            = lib$(BNCMATMUL_LIBNAME_SUFFIX).so
BNCMATMUL_DLLNAME_OMP        = lib$(BNCMATMUL_LIBNAME_OMP_SUFFIX).so
BNCMATMUL_LIB                = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_SUFFIX)
BNCMATMUL_LIB_OMP            = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_OMP_SUFFIX) -l$(BNCMATMUL_LIBNAME_SUFFIX)

# 128-bit SIMD AVX
BNCMATMUL_LIBNAME_AVX_SUFFIX     = $(BNCMATMUL_PREFIX)_avx
BNCMATMUL_LIBNAME_OMP_AVX_SUFFIX = $(BNCMATMUL_PREFIX)-omp_avx
BNCMATMUL_LIBNAME_AVX            = lib$(BNCMATMUL_LIBNAME_AVX_SUFFIX).a
BNCMATMUL_LIBNAME_OMP_AVX        = lib$(BNCMATMUL_LIBNAME_OMP_AVX_SUFFIX).a

# 128-bit SIMD NEON
BNCMATMUL_LIBNAME_NEON_SUFFIX     = $(BNCMATMUL_PREFIX)_neon
BNCMATMUL_LIBNAME_OMP_NEON_SUFFIX = $(BNCMATMUL_PREFIX)-omp_neon
BNCMATMUL_LIBNAME_NEON            = lib$(BNCMATMUL_LIBNAME_NEON_SUFFIX).a
BNCMATMUL_LIBNAME_OMP_NEON        = lib$(BNCMATMUL_LIBNAME_OMP_NEON_SUFFIX).a
BNCMATMUL_DLLNAME_NEON            = lib$(BNCMATMUL_LIBNAME_NEON_SUFFIX).so
BNCMATMUL_DLLNAME_OMP_NEON        = lib$(BNCMATMUL_LIBNAME_OMP_NEON_SUFFIX).so
BNCMATMUL_LIB_NEON                = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_NEON_SUFFIX)
BNCMATMUL_LIB_OMP_NEON            = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_OMP_NEON_SUFFIX) -l$(BNCMATMUL_LIBNAME_NEON_SUFFIX)

# 128-bit SIMD SVE2 (Armv9-A, Grace / Neoverse V2)
BNCMATMUL_LIBNAME_SVE2_SUFFIX     = $(BNCMATMUL_PREFIX)_sve2
BNCMATMUL_LIBNAME_OMP_SVE2_SUFFIX = $(BNCMATMUL_PREFIX)-omp_sve2
BNCMATMUL_LIBNAME_SVE2            = lib$(BNCMATMUL_LIBNAME_SVE2_SUFFIX).a
BNCMATMUL_LIBNAME_OMP_SVE2        = lib$(BNCMATMUL_LIBNAME_OMP_SVE2_SUFFIX).a
BNCMATMUL_DLLNAME_SVE2            = lib$(BNCMATMUL_LIBNAME_SVE2_SUFFIX).so
BNCMATMUL_DLLNAME_OMP_SVE2        = lib$(BNCMATMUL_LIBNAME_OMP_SVE2_SUFFIX).so
BNCMATMUL_LIB_SVE2                = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_SVE2_SUFFIX)
BNCMATMUL_LIB_OMP_SVE2            = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_OMP_SVE2_SUFFIX) -l$(BNCMATMUL_LIBNAME_SVE2_SUFFIX)

# 256-bit SIMD (AVX2)
BNCMATMUL_LIBNAME_AVX2_SUFFIX     = $(BNCMATMUL_PREFIX)_avx2
BNCMATMUL_LIBNAME_OMP_AVX2_SUFFIX = $(BNCMATMUL_PREFIX)-omp_avx2
BNCMATMUL_LIBNAME_AVX2            = lib$(BNCMATMUL_LIBNAME_AVX2_SUFFIX).a
BNCMATMUL_LIBNAME_OMP_AVX2        = lib$(BNCMATMUL_LIBNAME_OMP_AVX2_SUFFIX).a
BNCMATMUL_DLLNAME_AVX2            = lib$(BNCMATMUL_LIBNAME_AVX2_SUFFIX).so
BNCMATMUL_DLLNAME_OMP_AVX2        = lib$(BNCMATMUL_LIBNAME_OMP_AVX2_SUFFIX).so
BNCMATMUL_LIB_AVX2                = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_AVX2_SUFFIX)
BNCMATMUL_LIB_OMP_AVX2            = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_OMP_AVX2_SUFFIX) -l$(BNCMATMUL_LIBNAME_AVX2_SUFFIX)

# 512-bit SIMD (AVX-512)
BNCMATMUL_LIBNAME_AVX512_SUFFIX     = $(BNCMATMUL_PREFIX)_avx512
BNCMATMUL_LIBNAME_OMP_AVX512_SUFFIX = $(BNCMATMUL_PREFIX)-omp_avx512
BNCMATMUL_LIBNAME_AVX512            = lib$(BNCMATMUL_LIBNAME_AVX512_SUFFIX).a
BNCMATMUL_LIBNAME_OMP_AVX512        = lib$(BNCMATMUL_LIBNAME_OMP_AVX512_SUFFIX).a
BNCMATMUL_DLLNAME_AVX512            = lib$(BNCMATMUL_LIBNAME_AVX512_SUFFIX).so
BNCMATMUL_DLLNAME_OMP_AVX512        = lib$(BNCMATMUL_LIBNAME_OMP_AVX512_SUFFIX).so
BNCMATMUL_LIB_AVX512                = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_AVX512_SUFFIX)
BNCMATMUL_LIB_OMP_AVX512            = -L./ -L$(BNCMATMUL_LIBPATH) -l$(BNCMATMUL_LIBNAME_OMP_AVX512_SUFFIX) -l$(BNCMATMUL_LIBNAME_AVX512_SUFFIX)

# Winograd
WINOGRAD = winograd
BNCMATMUL_LIBNAME_WINOGRAD_SUFFIX            = $(BNCMATMUL_LIBNAME_SUFFIX)_$(WINOGRAD)
BNCMATMUL_LIBNAME_WINOGRAD_OMP_SUFFIX        = $(BNCMATMUL_LIBNAME_OMP_SUFFIX)_$(WINOGRAD)
BNCMATMUL_LIBNAME_WINOGRAD_AVX2_SUFFIX       = $(BNCMATMUL_LIBNAME_SUFFIX)_$(WINOGRAD)_avx2
BNCMATMUL_LIBNAME_WINOGRAD_AVX512_SUFFIX     = $(BNCMATMUL_LIBNAME_SUFFIX)_$(WINOGRAD)_avx512
BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX2_SUFFIX   = $(BNCMATMUL_LIBNAME_OMP_SUFFIX)_$(WINOGRAD)_avx2
BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX512_SUFFIX = $(BNCMATMUL_LIBNAME_OMP_SUFFIX)_$(WINOGRAD)_avx512
BNCMATMUL_LIBNAME_WINOGRAD            = lib$(BNCMATMUL_LIBNAME_WINOGRAD_SUFFIX).a
BNCMATMUL_LIBNAME_WINOGRAD_OMP        = lib$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_SUFFIX).a
BNCMATMUL_LIBNAME_WINOGRAD_AVX2       = lib$(BNCMATMUL_LIBNAME_WINOGRAD_AVX2_SUFFIX).a
BNCMATMUL_LIBNAME_WINOGRAD_AVX512     = lib$(BNCMATMUL_LIBNAME_WINOGRAD_AVX512_SUFFIX).a
BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX2   = lib$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX2_SUFFIX).a
BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX512 = lib$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX512_SUFFIX).a
BNCMATMUL_DLLNAME_WINOGRAD            = lib$(BNCMATMUL_LIBNAME_WINOGRAD_SUFFIX).so
BNCMATMUL_DLLNAME_WINOGRAD_OMP        = lib$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_SUFFIX).so
BNCMATMUL_DLLNAME_WINOGRAD_AVX2       = lib$(BNCMATMUL_LIBNAME_WINOGRAD_AVX2_SUFFIX).so
BNCMATMUL_DLLNAME_WINOGRAD_AVX512     = lib$(BNCMATMUL_LIBNAME_WINOGRAD_AVX512_SUFFIX).so
BNCMATMUL_DLLNAME_WINOGRAD_OMP_AVX2   = lib$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX2_SUFFIX).so
BNCMATMUL_DLLNAME_WINOGRAD_OMP_AVX512 = lib$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX512_SUFFIX).so
BNCMATMUL_LIB_WINOGRAD            = -L./ -L../ -l$(BNCMATMUL_LIBNAME_WINOGRAD_SUFFIX)
BNCMATMUL_LIB_WINOGRAD_OMP        = -L./ -L../ -l$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_SUFFIX) -l$(BNCMATMUL_LIBNAME_WINOGRAD_SUFFIX)
BNCMATMUL_LIB_WINOGRAD_AVX2       = -L./ -L../ -l$(BNCMATMUL_LIBNAME_WINOGRAD_AVX2_SUFFIX)
BNCMATMUL_LIB_WINOGRAD_AVX512     = -L./ -L../ -l$(BNCMATMUL_LIBNAME_WINOGRAD_AVX512_SUFFIX)
BNCMATMUL_LIB_WINOGRAD_OMP_AVX2   = -L./ -L../ -l$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX2_SUFFIX) -l$(BNCMATMUL_LIBNAME_WINOGRAD_AVX2_SUFFIX)
BNCMATMUL_LIB_WINOGRAD_OMP_AVX512 = -L./ -L../ -l$(BNCMATMUL_LIBNAME_WINOGRAD_OMP_AVX512_SUFFIX) -l$(BNCMATMUL_LIBNAME_WINOGRAD_AVX512_SUFFIX)

#---------------------------------------
# CUDA / GQD (left as-is; not driven by configure)
#---------------------------------------
NVCC = nvcc -g -DCUDA_FMA -arch=sm_30 -ccbin=$(CPP_ONLY) -Xcompiler='$(BNCMM_OPT_CXXFLAGS)'
GQD_INC_DIR = ./gqd_1_3/inc
GQD_INC = -I/usr/local/cuda/include -I$(GQD_INC_DIR)
GQD_LIB = -L/usr/local/cuda/lib64 -lcudart -lcudadevrt

#---------------------------------------
# Macros to compile programs with bncmatmul library
#---------------------------------------
# NOTE: $(BNCMATMUL_INC) MUST come first.  GMP/MPFR/MPC/QD are commonly
# installed under the same prefix that a previous `make install` put the
# BNCmatmul headers in; with $(COMMON_INC) first, -I<prefix>/include would
# shadow the in-tree include/ and the build would silently mix a stale
# installed rdd.h / c_dd_qd.h with fresh sources.
INC = $(BNCMATMUL_INC) $(COMMON_INC)
LIB = $(BNCMATMUL_LIB) $(COMMON_LIB)

LIB_OMP    = $(BNCMATMUL_LIB_OMP) $(COMMON_LIB)
LIB_AVX2   = $(BNCMATMUL_LIB_AVX2) $(COMMON_LIB)
LIB_OMP_AVX2 = $(BNCMATMUL_LIB_OMP_AVX2) $(COMMON_LIB)
LIB_AVX2_OMP = $(LIB_OMP_AVX2)

LIB_NEON     = $(BNCMATMUL_LIB_NEON) $(COMMON_LIB)
LIB_OMP_NEON = $(BNCMATMUL_LIB_OMP_NEON) $(COMMON_LIB)
LIB_NEON_OMP = $(LIB_OMP_NEON)

LIB_SVE2     = $(BNCMATMUL_LIB_SVE2) $(COMMON_LIB)
LIB_OMP_SVE2 = $(BNCMATMUL_LIB_OMP_SVE2) $(COMMON_LIB)
LIB_SVE2_OMP = $(LIB_OMP_SVE2)

LIB_AVX512     = $(BNCMATMUL_LIB_AVX512) $(COMMON_LIB)
LIB_OMP_AVX512 = $(BNCMATMUL_LIB_OMP_AVX512) $(COMMON_LIB)
LIB_AVX512_OMP = $(LIB_OMP_AVX512)

LIB_WINOGRAD            = $(BNCMATMUL_LIB_WINOGRAD) $(COMMON_LIB)
LIB_WINOGRAD_OMP        = $(BNCMATMUL_LIB_WINOGRAD_OMP) $(COMMON_LIB)
LIB_WINOGRAD_AVX2       = $(BNCMATMUL_LIB_WINOGRAD_AVX2) $(COMMON_LIB)
LIB_WINOGRAD_OMP_AVX2   = $(BNCMATMUL_LIB_WINOGRAD_OMP_AVX2) $(COMMON_LIB)
LIB_WINOGRAD_AVX512     = $(BNCMATMUL_LIB_WINOGRAD_AVX512) $(COMMON_LIB)
LIB_WINOGRAD_OMP_AVX512 = $(BNCMATMUL_LIB_WINOGRAD_OMP_AVX512) $(COMMON_LIB)

LIB_CC     = $(BNCMATMUL_LIB) $(COMMON_LIB)
LIB_CC_OMP = $(BNCMATMUL_LIB_OMP) $(COMMON_LIB)

#---------------------------------------
# Constants and Options for benchmark tests
#---------------------------------------
CACHE_SIZE   = 8192      # KB
MPF_PREC     = 1024      # in bits
OMP_NUM_THREADS = 4
ROW_DIM      = 128
MIN_DIM      = 32
MAX_SECONDS  = 300
LU_DIM       = 1024

#---------------------------------------
# Zip
#---------------------------------------
ZIP     = xz
ZIP_EXT = xz

#---------------------------------------
# MPLAPACK (optional; configure-controlled paths)
#---------------------------------------
MPLAPACK_INC      = -I/usr/local/include/mplapack
MPLAPACK_LIB      = -L/usr/local/lib
MPLAPACK_INC_PATH = /usr/local/include/mplapack
MPLAPACK_LIB_PATH = /usr/local/lib
MPLAPACK_LIBNAME  = mplapack
MPBLAS_LIBNAME    = mpblas
